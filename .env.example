# ============================================================
# .env.example — TEMPLATE ONLY. Copy to .env and fill values.
# NEVER commit .env to Git.
# ============================================================

# --- LLM APIs ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Google APIs ---
GOOGLE_CREDENTIALS_JSON=~/.config/ashvani-job-bot/credentials.json
SHEETS_ID=your_google_sheets_spreadsheet_id_here
CALENDAR_ID=primary
DRIVE_FOLDER_ID=your_google_drive_folder_id_for_prep_sheets

# --- Apify (Glassdoor scraping) ---
APIFY_API_TOKEN=your_apify_api_token_here

# --- Portal Credentials (prefer keyring for local dev) ---
LINKEDIN_EMAIL=your_linkedin_email_here
LINKEDIN_PASSWORD=your_linkedin_password_here
NAUKRI_EMAIL=your_naukri_email_here
NAUKRI_PASSWORD=your_naukri_password_here
INDEED_EMAIL=your_indeed_email_here
INDEED_PASSWORD=your_indeed_password_here
ANGELLIST_EMAIL=your_angellist_email_here
ANGELLIST_PASSWORD=your_angellist_password_here

# --- Database ---
DB_ENCRYPTION_KEY=generate_a_32char_random_key_here
DB_PATH=~/.config/ashvani-job-bot/job_tracker.db

# --- App Config ---
LOG_LEVEL=INFO
ENV=development
