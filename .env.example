# ============================================================
# .env.example — TEMPLATE ONLY. Copy to .env and fill values.
# NEVER commit .env to Git.
#
# SECURITY: No passwords stored here.
# Portal sessions use encrypted cookies — run tools/export-cookies.js
# ============================================================

# --- LLM APIs ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Google APIs ---
GOOGLE_CREDENTIALS_JSON=~/.config/ashvani-job-bot/credentials.json
SHEETS_ID=your_google_sheets_spreadsheet_id_here
CALENDAR_ID=primary
DRIVE_FOLDER_ID=your_google_drive_folder_id_for_prep_sheets

# --- Cookie-Based Session Auth ---
# AES-256-GCM key for encrypting portal cookies (32 random bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=your_base64_encoded_32byte_secret_here
# Path to encrypted cookie file (written by tools/export-cookies.js)
COOKIES_PATH=~/.config/ashvani-job-bot/cookies.enc

# --- Microservice URLs ---
# PDF generation service (Node.js + Puppeteer)
PDF_SERVICE_URL=http://localhost:3001
# Browser automation submitter service (Node.js + Playwright)
SUBMITTER_SERVICE_URL=http://localhost:3002

# --- Database (dedup cache only — Sheets is primary tracker) ---
DB_PATH=~/.config/ashvani-job-bot/job_tracker.db

# --- n8n Email Monitor ---
# Webhook URL called by n8n when interview is detected
PIPELINE_WEBHOOK_URL=http://localhost:8000/webhook/prep

# --- App Config ---
LOG_LEVEL=INFO
ENV=development

# --- Inter-Service Auth (Python → Node.js submitter) ---
# HMAC-SHA256 shared secret for /submit endpoint (min 32 chars, HIGH severity fix)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_TOKEN=your_hex_encoded_32byte_internal_token_here

# Allowed base directory for resume PDFs (path traversal fix)
# Only files within this directory can be submitted to portals
RESUME_BASE_DIR=~/.config/ashvani-job-bot/resumes
